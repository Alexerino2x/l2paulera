# Copie para scripts/servidor.env e ajuste. scripts/servidor.env fica fora do git.

# Banco de dados (MySQL 8 ou MariaDB 10.6+)
DB_HOST=localhost
DB_PORT=3306
DB_LOGIN=l2jfree_login
DB_GAME=l2jfree_game
DB_USER=l2j
DB_PASS=troque-esta-senha

# Comando com permissao de criar bancos e usuarios (usado so pelo install-db.sh)
MYSQL_ADMIN="sudo mysql"

# Endereco que os jogadores usam para chegar no game server.
# Sem playit (teste local): 127.0.0.1
# Com playit: o endereco do tunel TCP do game, ex.: algo-123.gl.joinplayit.gg
EXTERNAL_HOST=127.0.0.1

# Porta do game server. Com playit, use a MESMA porta publica do tunel do game
# e aponte o tunel para 127.0.0.1:<essa porta>.
GAME_PORT=7777

# Memoria da JVM
XMX_LOGIN=64m
XMX_GAME=1536m
